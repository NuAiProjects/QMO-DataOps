DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SESSION_SECRET=replace-with-long-random-string
APP_BASE_URL=http://localhost:5000
PGSSL_NO_VERIFY=true
DEV_AUTH=false
DEV_USER_EMAIL=admin@qmo.local
# Optional bootstrap credentials used to seed DB-backed per-user passwords
# when no credential exists yet (JSON object or array).
# Object format:
# LOCAL_AUTH_CREDENTIALS_JSON={"admin@qmo.local":"StrongPassword1","encoder":"StrongPassword2"}
# Array format:
# LOCAL_AUTH_CREDENTIALS_JSON=[{"username":"admin@qmo.local","password":"StrongPassword1","aliases":["admin"]}]
LOCAL_AUTH_CREDENTIALS_JSON={}
AUTH_PASSWORD_MIN_LENGTH=10

AUTH_LOGIN_RATE_LIMIT=true
AUTH_LOGIN_RATE_LIMIT_STORE=db
AUTH_LOGIN_WINDOW_MS=600000
AUTH_LOGIN_MAX_ATTEMPTS=5

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/login/google/callback

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/login/microsoft/callback
